---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro'
const courses = await getCollection('courses');
console.log(courses);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, ''); 

---
<Base title="Stacy Jung - ILP Portfolio">
	<div class="about-me">
		<p>hello! I am trying to experiment with Astro!</p>
	</div>
	<div>
		<ul>
			{courses.map(course => (
				<li><a href={`${baseUrl}/courses/${course.id}`}>{course.data.code}: {course.data.title}</a></li>
			))}
		</ul>
	</div>
</Base>

